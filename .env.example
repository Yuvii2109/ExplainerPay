# Copy to .env. Compose falls back to these same defaults if .env is absent.
POSTGRES_DB=pxe
POSTGRES_USER=pxe
POSTGRES_PASSWORD=pxe

# Read only by pxe-ai (phase 6). pxe-api never sees it.
GEMINI_API_KEY=

# Published host ports. Defaults are shifted off 5432/8080/8000/3000 to avoid
# collisions with unrelated projects on the same machine.
PXE_PORT_POSTGRES=15432
PXE_PORT_API=18080
PXE_PORT_AI=18000
PXE_PORT_WEB=13000
GEMINI_MODEL=gemini-3.5-flash-lite
